# Copy to .env and adjust. Never commit .env.
# Optional "Name email" for SEC requests; blank = generic project identity
SEC_IDENTITY=
PRIMARY_MODEL=ollama/finsight-qwen3
FALLBACK_MODELS=ollama/qwen3:8b,ollama/llama3.2:latest
# Market: US or IN (India)
MARKET=US
# Optional watchlist overrides:
# WATCHLIST_US=AAPL,MSFT,NVDA,JPM,XOM,JNJ
# WATCHLIST_IN=WIPRO.NS,ITC.NS,SUNPHARMA.NS,EICHERMOT.NS,BHARTIARTL.NS,ASIANPAINT.NS
# Optional cloud fallbacks (only used if set):
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Local runs talk to the dockerised Postgres; falls back to SQLite if it is down.
DATABASE_URL=postgresql+psycopg://finsight:finsight@localhost:5432/finsight
ANONYMIZED_TELEMETRY=False
CREWAI_TRACING_ENABLED=false
