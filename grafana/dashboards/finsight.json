  {
   "id": 6,
   "type": "timeseries",
   "title": "Portfolio vs SPY (growth of 100)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "finsight-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 14,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "finsight-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "select ts as time, equity/100000.0*100 as \"Portfolio\", benchmark / first_value(benchmark) over (order by ts) * 100 as \"SPY\" from snapshots where benchmark is not null order by ts"
    }
   ],
   "description": "Growth of 100 since the first snapshot. Snapshots are taken every 15 minutes by the scheduler; outside US market hours prices do not move, so both lines stay flat.",
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 2,
     "custom": {
      "showPoints": "always",
      "pointSize": 5,
      "lineWidth": 2,
      "spanNulls": true,
      "axisSoftMin": 99,
      "axisSoftMax": 101
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "SPY"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "last"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
