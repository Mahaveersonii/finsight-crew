   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "finsight-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "select ts as time, equity from snapshots order by ts"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "#5794F2"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
