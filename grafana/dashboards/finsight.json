  {
   "id": 4,
   "type": "stat",
   "title": "Crew success rate",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "finsight-pg"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "finsight-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "select coalesce(100.0*avg(case when status='success' then 1 else 0 end),0) as success from runs where status<>'running'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "color": {
